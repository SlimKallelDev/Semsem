{
  "expo": {
    "scheme": "semsemapp",
    "name": "Semsem",
    "slug": "Semsem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/startup-splash.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/startup-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/startup-splash.png",
        "backgroundColor": "#59BE56"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/startup-splash.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Semsem to detect your country and city for Near me filters."
        }
      ]
    ]
  }
}

