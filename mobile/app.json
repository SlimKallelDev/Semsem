{
  "expo": {
    "scheme": "semsemapp",
    "name": "Semsem Pets",
    "slug": "semsem-pets",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/startup-splash.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.semsem.pets",
      "buildNumber": "3",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.semsem.pets",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/startup-splash.png",
        "backgroundColor": "#59BE56"
      }
    },
    "web": {
      "favicon": "./assets/startup-splash.png",
      "splash": {
        "image": "./assets/startup-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Semsem to detect your country and city for Near me filters."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/startup-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "574e47a1-3ff2-4d19-9567-db8e747f744b"
      }
    }
  }
}
