{
  "expo": {
    "scheme": "semsemapp",
    "name": "Semsem Pets",
    "slug": "semsem-pets",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/startup-splash.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.semsem.pets",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.semsem.pets",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/startup-splash.png",
        "backgroundColor": "#59BE56"
      }
    },
    "web": {
      "favicon": "./assets/startup-splash.png",
      "splash": {
        "image": "./assets/startup-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Semsem to detect your country and city for Near me filters."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/startup-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
