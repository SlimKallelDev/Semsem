{
  "expo": {
    "scheme": "Semsemapp",
    "name": "Semsem",
    "slug": "Semsem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-logo-phone.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/startup-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-logo-phone.png",
        "backgroundColor": "#59BE56"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
